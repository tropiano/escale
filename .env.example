# Copy to .env for local development.
DEBUG=True
DATABASE_URL=postgres://localhost:5432/escale

# Production (set these in Appliku → Application → Environment variables)
# DEBUG=False
# SECRET_KEY=<long random string>
# ALLOWED_HOSTS=escale.applikuapp.com,www.yourdomain.ru
# CSRF_TRUSTED_ORIGINS=https://escale.applikuapp.com,https://www.yourdomain.ru
# DATABASE_URL is injected automatically when you attach an Appliku Postgres datastore.
